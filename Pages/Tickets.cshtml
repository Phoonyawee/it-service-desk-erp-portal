@page
@model TicketsModel
@using SupportFlow.Models
@{ ViewData["Title"] = "Tickets"; }

<div class="page-heading"><div><span class="eyebrow">SERVICE DESK</span><h1>Support tickets</h1></div></div>
@if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }

<details class="panel form-panel"><summary class="btn btn-primary">New ticket</summary>
    <h2>Create a ticket</h2>
    <form method="post" asp-page-handler="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-grid">
            <div class="wide"><label asp-for="Input.Title"></label><input asp-for="Input.Title" class="form-control" /><span asp-validation-for="Input.Title" class="text-danger"></span></div>
            <div><label asp-for="Input.Category"></label><select asp-for="Input.Category" class="form-select"><option>Hardware</option><option>Software</option><option>Network</option><option>ERP</option><option>Account</option></select></div>
            <div><label asp-for="Input.Priority"></label><select asp-for="Input.Priority" asp-items="Html.GetEnumSelectList<TicketPriority>()" class="form-select"></select></div>
            <div class="wide"><label asp-for="Input.Description"></label><textarea asp-for="Input.Description" class="form-control" rows="3"></textarea><span asp-validation-for="Input.Description" class="text-danger"></span></div>
        </div>
        <button class="btn btn-primary mt-3">Submit ticket</button>
    </form>
</details>

<section class="panel">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Ticket</th><th>Requester</th><th>Priority</th><th>Status</th><th>Action</th></tr></thead>
            <tbody>
            @foreach (var ticket in Model.Tickets)
            {
                <tr>
                    <td><strong>#@ticket.Id @ticket.Title</strong><small>@ticket.Category · @ticket.Description</small></td>
                    <td>@ticket.RequestedByName</td><td>@ticket.Priority</td><td><span class="status">@ticket.Status</span></td>
                    <td>
                    @if (Model.CanProcess)
                    {
                        TicketStatus? next = ticket.Status switch { TicketStatus.Open => TicketStatus.InProgress, TicketStatus.InProgress => TicketStatus.Resolved, TicketStatus.Resolved => TicketStatus.Closed, _ => null };
                        @if (next is not null) { <form method="post" asp-page-handler="Move" class="inline-form"><input type="hidden" name="id" value="@ticket.Id" /><input type="hidden" name="next" value="@next" /><button class="btn btn-sm btn-outline-primary">Move to @next</button></form> }
                    }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
